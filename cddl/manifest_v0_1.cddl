; AuspexAI Tenant Manifest schema, v0.1
;
; This CDDL definition is normative for the AuspexAI manifest format. The JSON
; Schema in schemas/manifest_v0_1.json mirrors this CDDL for JSON-tooling
; ergonomics, but the CDDL is the authoritative spec for receipt-format
; cross-references.
;
; Per Principles & Scope §11 (schema-versioning policy), this file is immutable
; once published. Major version bumps require an ADR.

manifest = {
  schema_version: "0.1",
  tenant_id: tstr .regexp "^[a-z][a-z0-9-]{2,63}$",
  tenant_maintainer_contact: tstr,
  experiment_id: tstr .regexp "^[a-z][a-z0-9-]{2,127}$",
  research_goal_paragraph: tstr,
  models: [+ model],
  prompt_set_characteristics: tstr,
  sensitive_content_flags: [* sensitive_flag],
  ? approver_attestations: [+ attestation],
  expected_duration_hours: number,
  replication_factor: uint .gt 0,
  work_unit_source: work_unit_source,
  executor: executor,
  reducer: reducer,
}

model = {
  id: tstr,
  version: tstr,
  local_weights_required: bool,
}

sensitive_flag = "dual_use" / "red_team" / "harmful_output_generation"

attestation = {
  approver_pubkey: tstr,
  sig: tstr,
}

work_unit_source = static_source / http_source

static_source = {
  kind: "static",
  tarball_sha256: tstr .regexp "^[a-f0-9]{64}$",
}

http_source = {
  kind: "http",
  url: tstr,
}

executor = {
  command: [+ tstr],
  ? image_sha256: tstr,
}

reducer = builtin_reducer / custom_reducer

builtin_reducer = {
  kind: "builtin_hash_agreement",
}

custom_reducer = {
  kind: "custom",
  command: [+ tstr],
  ? image_sha256: tstr,
}
