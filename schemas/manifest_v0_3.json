{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auspexai.network/schemas/manifest/v0.3",
  "title": "AuspexAI Tenant Manifest v0.3",
  "description": "Published manifest schema for AuspexAI tenant experiments, v0.3. Mirrors the normative CDDL in cddl/manifest_v0_3.cddl. v0.3 is a superset of v0.2: it adds ONE optional member — feature_schema (D16.1: the self-describing feature schema). Enforcement keys on presence, so a v0.3 manifest declaring no feature_schema is structurally a v0.2 manifest with schema_version bumped. v0.1/v0.2 manifests stay valid forever (no forced migration). Per the schema-versioning policy (Principles & Scope §11 Q20), this file is immutable once published.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "tenant_maintainer_contact",
    "experiment_id",
    "research_goal_paragraph",
    "models",
    "prompt_set_characteristics",
    "sensitive_content_flags",
    "expected_duration_hours",
    "replication_factor",
    "work_unit_source",
    "executor",
    "reducer"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.3"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "description": "Lowercase slug, 3-64 chars, starts with a letter."
    },
    "tenant_maintainer_contact": {
      "type": "string",
      "format": "email"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,127}$"
    },
    "research_goal_paragraph": {
      "type": "string",
      "minLength": 50,
      "maxLength": 2000,
      "description": "One-paragraph volunteer-readable research goal (Principles §5.14)."
    },
    "research_class": {
      "type": "string",
      "enum": [
        "behavioral_drift",
        "eval_sweeps",
        "refusal_boundary_mapping",
        "cross_model_comparison",
        "quantization_effects",
        "prompt_sensitivity",
        "other"
      ],
      "description": "§9 #48: declared research class for class-by-tier auto-approval. Optional; omitted ⇒ human review."
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "local_weights_required"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "local_weights_required": { "type": "boolean" },
          "hf_repo": {
            "type": "string",
            "description": "Optional HuggingFace repo (e.g. 'Org/Model-GGUF') for M3 lazy auto-acquire."
          },
          "hf_filename": {
            "type": "string",
            "description": "Optional exact file within hf_repo (the pinned GGUF quant) so consensus replicas run an identical quant."
          },
          "expected_gguf_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "v0.2 / M3 (#13b): the expected sha256 of the served GGUF weights. When set, the coordinator REJECTS a result whose worker-reported served digest differs — the declared model provably ran (§11 amendment 2 / §9 #48 cross-model performance unlock). Omit ⇒ behavioral-only (status quo)."
          }
        }
      }
    },
    "prompt_set_characteristics": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000,
      "description": "High-level description only, not the literal prompts (Principles §5.14)."
    },
    "sensitive_content_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["dual_use", "red_team", "harmful_output_generation"]
      },
      "uniqueItems": true,
      "description": "Per Principles §5.12 research ethics. If any flag is set, approver_attestations is required."
    },
    "approver_attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approver_pubkey", "sig"],
        "properties": {
          "approver_pubkey": {
            "type": "string",
            "pattern": "^ed25519:[A-Za-z0-9+/=]+$"
          },
          "sig": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/=]+$"
          }
        }
      }
    },
    "expected_duration_hours": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 8760,
      "description": "Expected wall-clock duration of the experiment, in hours."
    },
    "replication_factor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "work_unit_source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "tarball_sha256"],
          "properties": {
            "kind": { "const": "static" },
            "tarball_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "http" },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      ]
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "reducer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "builtin_hash_agreement" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "builtin_within_cell_tolerance" },
            "tolerance_features": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command"],
          "properties": {
            "kind": { "const": "custom" },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "image_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "requires_real_execution": {
      "type": "boolean",
      "description": "v0.2 / M2: declare that units run real code (vs a synthetic harness), so the scheduler keeps them off synthetic/echo workers even when no local weights are required. Default false."
    },
    "inference_determinism": {
      "type": "object",
      "additionalProperties": false,
      "description": "v0.2 / M1: the determinism profile for a consensus inference run. The worker pins temperature/seed and, when serving_version_pin is set, hard-refuses (retryably) a unit whose serving stack is outside the pin.",
      "properties": {
        "temperature": { "type": "number" },
        "seed": { "type": "integer" },
        "serving_version_pin": {
          "type": "string",
          "description": "e.g. 'ollama/0.17.7' — the worker must serve a matching version or refuse."
        },
        "hardware_class": {
          "type": "string",
          "description": "e.g. 'cpu' | 'cuda'."
        }
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_level"],
      "description": "v0.2 / M4: the declared measurement type of a unit's result, so the SDK loader + dashboard type results instead of guessing (Stevens typology).",
      "properties": {
        "measurement_level": {
          "type": "string",
          "enum": ["nominal", "ordinal", "interval", "ratio"]
        },
        "shape": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "[] scalar · [N] vector · [R,C] matrix."
        },
        "dtype": {
          "type": "string",
          "description": "e.g. 'float32' | 'int' | 'string'."
        }
      }
    },
    "feature_schema": {
      "type": "object",
      "description": "v0.3 / D16.1: the self-describing feature schema, keyed by the dotted result-payload path the executor emits (e.g. 'lexical.type_token_ratio'; load_verified prefixes the column with 'output.'). Each value declares the feature's meaning, §7-safe type + bounds, what a change implies, role (feature authority), and how replicas are compared (the C7 tolerance envelope). There is NO free-text kind — a string is a closed `categorical` or a `hash` (the §7 no-raw-text guarantee). The per-kind required-bounds rules are enforced by the SDK model + the coordinator; this schema mirrors the structure.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["meaning", "kind", "role", "change_means"],
        "properties": {
          "meaning": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["hash", "count", "numeric", "categorical", "ordinal", "set"]
          },
          "role": {
            "type": "string",
            "enum": ["anchor", "summary", "provenance", "key", "diagnostic"]
          },
          "change_means": { "type": "string", "minLength": 1 },
          "unit": { "type": "string" },
          "range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min"],
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "algorithm": { "type": "string" },
          "element_kind": {
            "type": "string",
            "enum": ["categorical", "numeric", "count", "hash"]
          },
          "max_cardinality": { "type": "integer", "minimum": 1 },
          "invariant_to": {
            "type": "array",
            "items": { "type": "string" }
          },
          "valid_when": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "op", "value"],
            "properties": {
              "field": { "type": "string" },
              "op": { "type": "string", "enum": [">=", "<=", ">", "<", "==", "!="] },
              "value": { "type": ["number", "string"] }
            }
          },
          "comparison": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule"],
            "properties": {
              "rule": {
                "type": "string",
                "enum": ["exact", "numeric", "set_jaccard", "categorical_exact"]
              },
              "rel": { "type": "number" },
              "abs": { "type": "number" },
              "min": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sensitive_content_flags": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["sensitive_content_flags"]
      },
      "then": {
        "required": ["approver_attestations"],
        "properties": {
          "approver_attestations": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
