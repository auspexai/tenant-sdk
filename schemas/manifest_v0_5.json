{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auspexai.network/schemas/manifest/v0.5",
  "title": "AuspexAI Tenant Manifest v0.5",
  "description": "Published manifest schema for AuspexAI tenant experiments, v0.5. Mirrors the normative CDDL in cddl/manifest_v0_5.cddl. v0.5 is a superset of v0.4: it adds NO new member; it extends the existing optional inference_determinism member with the ratified seeded-sampling whitelist (top_p / top_k / min_p) and makes the pinned-seed floor structural (temperature > 0 requires seed; sampling knobs require temperature > 0). Generation policy is per-experiment and manifest-declared, never a platform law (inference_determinism_scoping_memo, RATIFIED 2026-07-02). Enforcement keys on presence; v0.1-v0.4 manifests stay valid forever (no forced migration; re-verify-forever).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "tenant_maintainer_contact",
    "experiment_id",
    "research_goal_paragraph",
    "models",
    "prompt_set_characteristics",
    "sensitive_content_flags",
    "expected_duration_hours",
    "replication_factor",
    "work_unit_source",
    "executor",
    "reducer"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.5"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "description": "Lowercase slug, 3-64 chars, starts with a letter."
    },
    "tenant_maintainer_contact": {
      "type": "string",
      "format": "email"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,127}$"
    },
    "research_goal_paragraph": {
      "type": "string",
      "minLength": 50,
      "maxLength": 2000,
      "description": "One-paragraph volunteer-readable research goal (Principles §5.14)."
    },
    "research_class": {
      "type": "string",
      "enum": [
        "behavioral_drift",
        "eval_sweeps",
        "refusal_boundary_mapping",
        "cross_model_comparison",
        "quantization_effects",
        "prompt_sensitivity",
        "other"
      ],
      "description": "§9 #48: declared research class for class-by-tier auto-approval. Optional; omitted ⇒ human review."
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "local_weights_required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "local_weights_required": {
            "type": "boolean"
          },
          "hf_repo": {
            "type": "string",
            "description": "Optional HuggingFace repo (e.g. 'Org/Model-GGUF') for M3 lazy auto-acquire."
          },
          "hf_filename": {
            "type": "string",
            "description": "Optional exact file within hf_repo (the pinned GGUF quant) so consensus replicas run an identical quant."
          },
          "expected_gguf_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "v0.2 / M3 (#13b): the expected sha256 of the served GGUF weights. When set, the coordinator REJECTS a result whose worker-reported served digest differs — the declared model provably ran (§11 amendment 2 / §9 #48 cross-model performance unlock). Omit ⇒ behavioral-only (status quo)."
          }
        }
      }
    },
    "prompt_set_characteristics": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000,
      "description": "High-level description only, not the literal prompts (Principles §5.14)."
    },
    "sensitive_content_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "dual_use",
          "red_team",
          "harmful_output_generation"
        ]
      },
      "uniqueItems": true,
      "description": "Per Principles §5.12 research ethics. If any flag is set, approver_attestations is required."
    },
    "approver_attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approver_pubkey",
          "sig"
        ],
        "properties": {
          "approver_pubkey": {
            "type": "string",
            "pattern": "^ed25519:[A-Za-z0-9+/=]+$"
          },
          "sig": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/=]+$"
          }
        }
      }
    },
    "expected_duration_hours": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 8760,
      "description": "Expected wall-clock duration of the experiment, in hours."
    },
    "replication_factor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "work_unit_source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tarball_sha256"
          ],
          "properties": {
            "kind": {
              "const": "static"
            },
            "tarball_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "http"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      ]
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "reducer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "builtin_hash_agreement"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "builtin_within_cell_tolerance"
            },
            "tolerance_features": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command"
          ],
          "properties": {
            "kind": {
              "const": "custom"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "image_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "requires_real_execution": {
      "type": "boolean",
      "description": "v0.2 / M2: declare that units run real code (vs a synthetic harness), so the scheduler keeps them off synthetic/echo workers even when no local weights are required. Default false."
    },
    "inference_determinism": {
      "type": "object",
      "additionalProperties": false,
      "description": "v0.2 / M1: the generation policy for a consensus inference run. greedy (temperature 0 / omitted) is byte-for-byte deterministic decoding, the default; seeded-sampling (temperature > 0) requires a pinned seed and may declare the v0.5 whitelist knobs top_p / top_k / min_p. The worker's broker honors the declared values per-request and rejects anything beyond them; when serving_version_pin is set the worker hard-refuses (retryably) a unit whose serving stack is outside the pin.",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "seed": {
          "type": "integer"
        },
        "serving_version_pin": {
          "type": "string",
          "description": "e.g. 'ollama/0.17.7' — the worker must serve a matching version or refuse."
        },
        "hardware_class": {
          "type": "string",
          "description": "e.g. 'cpu' | 'cuda'."
        },
        "top_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "v0.5 sampling knob (whitelist; only under temperature > 0)."
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "description": "v0.5 sampling knob (whitelist; only under temperature > 0)."
        },
        "min_p": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "description": "v0.5 sampling knob (whitelist; only under temperature > 0)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "temperature": {
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "temperature"
            ]
          },
          "then": {
            "required": [
              "seed"
            ]
          },
          "$comment": "seeded sampling requires a pinned seed (reproducibility floor)."
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "top_p"
                ]
              },
              {
                "required": [
                  "top_k"
                ]
              },
              {
                "required": [
                  "min_p"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "temperature": {
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "temperature"
            ]
          },
          "$comment": "sampling knobs are only meaningful under temperature > 0."
        }
      ]
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_level"
      ],
      "description": "v0.2 / M4: the declared measurement type of a unit's result, so the SDK loader + dashboard type results instead of guessing (Stevens typology).",
      "properties": {
        "measurement_level": {
          "type": "string",
          "enum": [
            "nominal",
            "ordinal",
            "interval",
            "ratio"
          ]
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "[] scalar · [N] vector · [R,C] matrix."
        },
        "dtype": {
          "type": "string",
          "description": "e.g. 'float32' | 'int' | 'string'."
        }
      }
    },
    "feature_schema": {
      "type": "object",
      "description": "v0.3 / D16.1: the self-describing feature schema, keyed by the dotted result-payload path the executor emits (e.g. 'lexical.type_token_ratio'; load_verified prefixes the column with 'output.'). Each value declares the feature's meaning, §7-safe type + bounds, what a change implies, role (feature authority), and how replicas are compared (the C7 tolerance envelope). There is NO free-text kind — a string is a closed `categorical` or a `hash` (the §7 no-raw-text guarantee). The per-kind required-bounds rules are enforced by the SDK model + the coordinator; this schema mirrors the structure.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "meaning",
          "kind",
          "role",
          "change_means"
        ],
        "properties": {
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "hash",
              "count",
              "numeric",
              "categorical",
              "ordinal",
              "set"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "anchor",
              "summary",
              "provenance",
              "key",
              "diagnostic"
            ]
          },
          "change_means": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min"
            ],
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "algorithm": {
            "type": "string"
          },
          "element_kind": {
            "type": "string",
            "enum": [
              "categorical",
              "numeric",
              "count",
              "hash"
            ]
          },
          "max_cardinality": {
            "type": "integer",
            "minimum": 1
          },
          "invariant_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "valid_when": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "op",
              "value"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  ">=",
                  "<=",
                  ">",
                  "<",
                  "==",
                  "!="
                ]
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              }
            }
          },
          "comparison": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "enum": [
                  "exact",
                  "numeric",
                  "set_jaccard",
                  "categorical_exact"
                ]
              },
              "rel": {
                "type": "number"
              },
              "abs": {
                "type": "number"
              },
              "min": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "pre_registration": {
      "type": "object",
      "description": "v0.4 / D16.2: the pre-registered design — hypothesis, analysis, and decision rule declared BEFORE data exists. `features` NAMES declared feature_schema paths; the pre-registered comparison envelope IS each feature's `comparison` in this same signed manifest (referenced, never duplicated). §7-safe: describes the design over declared features, never raw output. A post-hoc analysis change is a signed, append-only deviation record, never an edit.",
      "additionalProperties": false,
      "required": [
        "hypothesis",
        "analysis_method",
        "features",
        "timescale",
        "decision_rule",
        "expected_result",
        "stopping_rule"
      ],
      "properties": {
        "version": {
          "type": "string",
          "const": "0.1",
          "default": "0.1"
        },
        "hypothesis": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "analysis_method": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "dotted feature_schema paths the analysis reads; each must be declared and carry a 'comparison'"
        },
        "timescale": {
          "type": "string",
          "enum": [
            "intra_experiment_rounds",
            "long_horizon",
            "inter_experiment"
          ]
        },
        "decision_rule": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "expected_result": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2000
        },
        "stopping_rule": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000,
          "description": "declared up front so stopping is never data-peeking-dependent"
        },
        "comparison_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "stable join keys (esp. inter-experiment drift series); must be declared features"
        },
        "min_replication": {
          "type": "integer",
          "minimum": 1,
          "description": "optional power declaration: minimum corroboration for the claim"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sensitive_content_flags": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "sensitive_content_flags"
        ]
      },
      "then": {
        "required": [
          "approver_attestations"
        ],
        "properties": {
          "approver_attestations": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
